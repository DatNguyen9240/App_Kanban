# ==============================================================
# CẤU HÌNH SERVER VÀ DATABASE (POSTGRESQL / SQLITE)
# ==============================================================

# Cổng chạy backend Go (mặc định 8080)
PORT=8080
GIN_MODE=release

# --------------------------------------------------------------
# 1. CẤU HÌNH POSTGRESQL (Khuyên dùng để KHÔNG BAO GIỜ MẤT DỮ LIỆU)
# --------------------------------------------------------------
DB_TYPE=postgres

# Mẫu 1: Dùng PostgreSQL trên Railway (Lấy ở tab Connect -> Public Networking)
DATABASE_URL=postgresql://postgres:MAT_KHAU@roundhouse.proxy.rlwy.net:PORT/railway

# Mẫu 2: Dùng PostgreSQL trên Supabase (Miễn phí vĩnh viễn)
# DATABASE_URL=postgresql://postgres:MAT_KHAU@db.xxx.supabase.co:5432/postgres?sslmode=require

# Mẫu 3: Dùng PostgreSQL trên Neon.tech (Miễn phí vĩnh viễn)
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Mẫu 4: Dùng PostgreSQL cài sẵn ở máy local
# DATABASE_URL=host=localhost user=postgres password=postgres dbname=kanban_db port=5432 sslmode=disable

# --------------------------------------------------------------
# 2. CẤU HÌNH SQLITE (Chỉ dùng test offline cục bộ ở máy)
# --------------------------------------------------------------
# DB_TYPE=sqlite
# DATABASE_URL=kanban.db

# --------------------------------------------------------------
# 3. BẢO MẬT & XÁC THỰC JWT
# --------------------------------------------------------------
JWT_SECRET=super-secret-kanban-jwt-key-2026
